# Copy this file to .env and fill in your values.

# The stayup-api instance this connector reports to.
STAYUP_API_URL=http://localhost:3000

# API key for the 'scrap' provider, created from that instance's admin
# (Settings → Connector keys). Scoped to 'scrap' only.
STAYUP_API_KEY=

# Web admin (docker compose up admin) — curate the scrap fluxes at http://localhost:8000
SCRAP_ADMIN_EMAIL=admin@example.com
SCRAP_ADMIN_PASSWORD=change-me
SCRAP_ADMIN_SECRET=replace-with-a-long-random-string

# The stayup-api admin account admin.py authenticates as when it calls
# /ui/repositories on the operator's behalf. Create it with
# `npm run create-admin` on the stayup-api instance.
STAYUP_API_ADMIN_EMAIL=
STAYUP_API_ADMIN_PASSWORD=
